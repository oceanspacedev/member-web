APP_NAME="Ocean Space"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Horizon butuh QUEUE_CONNECTION=redis + Redis berjalan (server Linux). predis = tanpa ekstensi PHP tambahan.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ocean Space — aturan poin
LOYALTY_POINT_VALUE=10
LOYALTY_QR_TTL=120

# Verifikasi struk otomatis (foto struk -> poin) dengan Gemini. Tanpa kunci, semua struk masuk antrean admin.
GEMINI_API_KEY=
LOYALTY_RECEIPT_READER=gemini
LOYALTY_RECEIPT_MODEL=gemini-3.8-flash
LOYALTY_RECEIPT_AUTO_MAX_AMOUNT=2000000
# log = OTP hanya ditulis ke storage/logs; waghub = dikirim lewat WAGHub
WHATSAPP_DRIVER=log
# WAGHub WhatsApp gateway (OTP)
WAG_URL=https://waghub.mekayastudio.com
WAG_TOKEN=
# Nomor akun demo seeder: di APP_ENV=local OTP-nya hanya masuk log
WHATSAPP_DEMO_NUMBERS=6281200000001,6281200000002,6281200000003
# Client ID OAuth Google (Android/iOS/Web), pisahkan dengan koma
GOOGLE_CLIENT_IDS=

# Akun admin awal panel web (/admin) — dipakai seeder. Ganti password lewat menu profil di panel.
ADMIN_EMAIL=admin@lifestyleclub.test
ADMIN_PASSWORD=

# Beli voucher dengan uang — Xendit Payment Session. Selama uji coba pakai key Test Mode (xnd_development_...).
# Dashboard Xendit: Settings > Developers > API Keys (Money-In: Write) dan Webhooks (Verification Token).
PAYMENT_DRIVER=xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Opsional, harus HTTPS: halaman setelah bayar.
XENDIT_RETURN_URL=

# Halaman hukum publik (/kebijakan-privasi, /syarat-ketentuan, /hapus-akun): badan usaha & kontak yang ditampilkan.
# Isi sebelum rilis ke App Store / Play Store. WhatsApp format internasional tanpa +, mis. 6281234567890.
LEGAL_ENTITY=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Tombol unduh di landing page (/) dan tautan pendek /unduh. Isi setelah aplikasi tayang; kosong = "Segera hadir".
PLAY_STORE_URL=
APP_STORE_URL=
